{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "mobile:serve": "next start -H 127.0.0.1 -p 3000",
    "mobile:stable": "next build && next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:multi-service": "vitest run --config vitest.multi-service.config.ts --coverage src/lib/multi-service-booking.spec.ts",
    "test:packages": "vitest run --config vitest.packages.config.ts --coverage src/lib/package-booking.spec.ts",
    "sync:firebase": "bash scripts/sync-firebase-from-provider.sh",
    "native:note": "echo 'Native iOS/Android: use ../provider-app (Ionic React). Capacitor in frontend/ is deprecated.'"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "date-fns": "^4.3.0",
    "firebase": "^12.14.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-phone-number-input": "^3.4.16",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "7.6.5",
    "@capacitor/ios": "^8.3.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}

{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "mobile:serve": "next start -H 127.0.0.1 -p 3000",
    "mobile:stable": "next build && next start -H 127.0.0.1 -p 3000",
    "lint": "eslint src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:multi-service": "vitest run --config vitest.multi-service.config.ts --coverage src/lib/multi-service-booking.spec.ts",
    "test:packages": "vitest run --config vitest.packages.config.ts --coverage src/lib/package-booking.spec.ts",
    "test:localized-names": "vitest run --config vitest.localized-names.config.ts --coverage src/lib/localized-names.spec.ts",
    "test:locale-dates": "vitest run --config vitest.locale-dates.config.ts --coverage",
    "test:public-locale": "vitest run --config vitest.public-locale.config.ts --coverage",
    "test:appointment-modal": "vitest run --config vitest.appointment-modal.config.ts --coverage",
    "test:dashboard-modals": "vitest run --config vitest.dashboard-modals.config.ts --coverage",
    "test:employees": "vitest run --config vitest.employees.config.ts --coverage",
    "test:toasts-errors": "vitest run --config vitest.toasts-errors.config.ts --coverage",
    "test:i18n-clinic-v2": "vitest run --config vitest.i18n-clinic-v2.config.ts --coverage",

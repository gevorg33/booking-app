    "test:sprint28": "vitest run --config vitest.sprint28.config.ts --coverage",
    "test:sprint29": "vitest run --config vitest.sprint29.config.ts --coverage",
    "test:sprint30": "vitest run --config vitest.sprint30.config.ts --coverage",
    "test:sprint31": "vitest run --config vitest.sprint31.config.ts --coverage",
    "test:sprint54": "vitest run --config vitest.sprint54.config.ts --coverage",
    "test:sprint32": "vitest run --config vitest.sprint32.config.ts --coverage",
    "test:sprint34": "vitest run --config vitest.sprint34.config.ts --coverage",
    "test:sprint36": "vitest run --config vitest.sprint36.config.ts --coverage",
    "test:sprint37": "vitest run --config vitest.sprint37.config.ts --coverage",

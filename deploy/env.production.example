# Copy to deploy/.env.production and fill in values.
BOOKING_ROOT_DOMAIN=example.com

DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=booking_platform

JWT_SECRET=change-me-long-random-secret

# For render-nginx-config.sh (vercel-railway template)

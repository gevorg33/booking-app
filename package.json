{
  "name": "booking-platform",
  "private": true,
  "description": "Orchestrix booking monorepo — use scripts/ for local dev",
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:lan": "bash scripts/dev-lan.sh",
    "dev:lan:be": "bash scripts/dev-lan-backend.sh",
    "dev:frontend": "bash scripts/dev-frontend.sh",
    "dev:backend": "bash scripts/dev-backend.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "deploy:frontend": "bash scripts/deploy-vercel.sh --prod",
    "deploy:backend": "bash scripts/deploy-railway.sh up --detach",
    "test": "npm run test --prefix backend && npm run test --prefix frontend && npm run test --prefix consumer-app && npm run test --prefix provider-app",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:consumer-app": "npm run test --prefix consumer-app",
    "test:provider-app": "npm run test --prefix provider-app"
  }
}

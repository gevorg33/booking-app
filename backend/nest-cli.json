{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "modules/ai/guide/*.json",
        "outDir": "dist"
      },
      {
        "include": "modules/ai/guide/guide-flows/**/*.json",
        "outDir": "dist"
      },
      {
        "include": "modules/ai/ai-completion-floors.json",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}

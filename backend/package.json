{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:growth": "jest --coverage --collectCoverageFrom='modules/integrations/zendesk/**/*.ts' --collectCoverageFrom='!**/*.spec.ts' --collectCoverageFrom='modules/integrations/distribution/**/*.ts' --testPathPatterns='(integrations/(zendesk|distribution)|integrations-growth|public-booking-growth)' --coverageThreshold='{\"global\":{\"statements\":90,\"branches\":90,\"functions\":90,\"lines\":90}}'",
    "test:phase3": "jest --coverage --collectCoverageFrom='common/utils/locale-format.util.ts' --collectCoverageFrom='modules/customer/customer-privacy*.ts' --collectCoverageFrom='modules/integrations/zapier/**/*.ts' --collectCoverageFrom='modules/integrations/accounting/**/*.ts' --collectCoverageFrom='modules/provider-mobile/listeners/provider-push.listener.ts' --collectCoverageFrom='modules/provider-mobile/provider-end-of-day-push.scheduler.ts' --collectCoverageFrom='!**/*.spec.ts' --testPathPatterns='(locale-format|customer-privacy|zapier|accounting|provider-push|provider-end-of-day|integrations-platform)' --coverageThreshold='{\"global\":{\"statements\":90,\"branches\":80,\"functions\":90,\"lines\":90}}'",
    "test:sprint1-3": "jest --coverage --collectCoverageFrom='common/utils/commission-payout.util.ts' --collectCoverageFrom='modules/commissions/commissions.service.ts' --collectCoverageFrom='modules/integrations/integrations-docs.service.ts' --collectCoverageFrom='modules/integrations/webhook-dispatcher.listener.ts' --collectCoverageFrom='modules/integrations/accounting/accounting-integration.service.ts' --collectCoverageFrom='modules/provider-mobile/push.service.ts' --collectCoverageFrom='modules/provider-mobile/listeners/provider-push.listener.ts' --collectCoverageFrom='!**/*.spec.ts' --testPathPatterns='(commission-payout|commissions.service|integrations-docs|webhook-dispatcher|accounting-integration|push.service|provider-push|reviews.service)' --coverageThreshold='{\"global\":{\"statements\":90,\"branches\":80,\"functions\":90,\"lines\":90}}'",
    "test:sprint4": "jest --coverage --collectCoverageFrom='modules/inventory/inventory.service.ts' --collectCoverageFrom='!**/*.spec.ts' --testPathPatterns='inventory.service' --coverageThreshold='{\"global\":{\"statements\":90,\"branches\":80,\"functions\":90,\"lines\":90}}'",
    "test:sprint5": "jest --coverage --collectCoverageFrom='common/utils/resource-scheduling.util.ts' --collectCoverageFrom='common/utils/subscription-pricing.util.ts' --collectCoverageFrom='common/utils/subscription-checkout.util.ts' --collectCoverageFrom='modules/resources/scheduling-resources.service.ts' --collectCoverageFrom='modules/service-subscriptions/service-subscriptions.service.ts' --collectCoverageFrom='modules/service-subscriptions/service-subscriptions.controller.ts' --collectCoverageFrom='!**/*.spec.ts' --testPathPatterns='(resource-scheduling|subscription-pricing|subscription-checkout|scheduling-resources.service|service-subscriptions)' --coverageThreshold='{\"global\":{\"statements\":95,\"branches\":85,\"functions\":95,\"lines\":95}}'",
    "test:monetization": "jest --coverage --collectCoverageFrom='modules/loyalty/loyalty-settings.util.ts' --collectCoverageFrom='modules/loyalty/loyalty-award.service.ts' --collectCoverageFrom='modules/promo-codes/promo-codes.service.ts' --collectCoverageFrom='modules/gift-cards/gift-cards.service.ts' --collectCoverageFrom='!**/*.spec.ts' --testPathPatterns='(loyalty-settings.util|loyalty-award.service|promo-codes.service|gift-cards.service)' --coverageThreshold='{\"global\":{\"statements\":95,\"branches\":85,\"functions\":95,\"lines\":95}}'",
    "test:checkout": "jest --coverage --collectCoverageFrom='modules/booking/booking-payment.service.ts' --collectCoverageFrom='modules/promo-codes/checkout-pricing.service.ts' --collectCoverageFrom='modules/promo-codes/checkout-pricing.util.ts' --collectCoverageFrom='common/utils/subscription-checkout.util.ts' --collectCoverageFrom='!**/*.spec.ts' --testPathPatterns='(booking-payment.service|checkout-pricing|subscription-checkout.util)' --coverageThreshold='{\"global\":{\"statements\":95,\"branches\":87,\"functions\":95,\"lines\":95}}'",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "node scripts/run-migrations.mjs",
    "backfill:loyalty": "nest build && node dist/scripts/backfill-loyalty-points.js",
    "fix:loyalty": "nest build && node dist/scripts/recalculate-loyalty-earnings.js"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.7",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.24",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "dayjs": "^1.11.21",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.10.1",
    "openai": "^6.39.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "typeorm": "^1.0.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^4.10.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=booking_platform

# App
PORT=3001
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS / Frontend URL (Stripe redirect URLs)
CORS_ORIGIN=http://localhost:3000
ROOT_DOMAIN=localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative to the three vars above:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# OpenAI (AI command bar, onboarding catalog, public booking assistant, agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangGraph — grounded AI orchestration (see docs/AI_COMMAND_ARCHITECTURE.md)
# Master switch enables command graph, agent subgraphs, and ReAct tool agent:
LANGGRAPH_ENABLED=false
# LANGGRAPH_COMMANDS=true       # Command graph routing (single/compound/ReAct)
# LANGGRAPH_REACT_AGENT=true    # ReAct tool agent for orchestration/ambiguous prompts
# LANGGRAPH_AGENTS=true         # Agent subgraphs (optimize, conflicts, recovery)
# LANGGRAPH_CANCELLATION_RECOVERY=true

# Capacitor provider app — set in frontend/.env.local (use LAN IP for physical devices)
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000/provider/today

# Web Push (provider PWA — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# Firebase (Google Sign-In + push for provider app)
# Easiest: save downloaded JSON as backend/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Frontend public portal reviews — set the same values in frontend/.env.local (NEXT_PUBLIC_FIREBASE_*)
# Enable Google provider in Firebase Console → Authentication → Sign-in method
# Or paste entire JSON on ONE line (no line breaks):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Stripe (platform subscriptions + Connect for client prepay at booking)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform default country fallback for Express onboarding
STRIPE_CONNECT_DEFAULT_COUNTRY=AE
# direct = booking payments on tenant account; destination = platform charges + transfer_data
STRIPE_CONNECT_CHARGE_MODEL=direct
# Optional platform fee on destination charges (tenant gets the rest via transfer_data.amount)
# STRIPE_CONNECT_PLATFORM_FEE_PERCENT=10
# OAuth — tenant connects their own Stripe (recommended for multi-country SaaS)
# Dashboard → Connect → Settings → OAuth → client ID (ca_...)
STRIPE_CONNECT_CLIENT_ID=ca_...
# Register redirect: http://localhost:3000/dashboard/billing?stripe_connect=oauth

# Email reminders (Resend — https://resend.com)
# Without this, confirmation/reminder emails are logged to the console in dev.
RESEND_API_KEY=re_...
NOTIFICATION_FROM_EMAIL=bookings@yourdomain.com
# Optional: send all post-visit review emails here (e.g. Resend sandbox verified address)
# REVIEW_REQUEST_EMAIL_OVERRIDE=you@example.com

# SMS reminders (Twilio — https://twilio.com)
# Without these, SMS messages are logged to the console in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# WhatsApp Business Cloud API (Meta — https://developers.facebook.com/docs/whatsapp/cloud-api)
# Platform default — used for new tenants until they connect their own WhatsApp in Dashboard settings.
INTEGRATIONS_ENCRYPTION_KEY=
# Per-tenant PHI field encryption (HIPAA mode). Falls back to INTEGRATIONS_ENCRYPTION_KEY / JWT_SECRET in dev.
PHI_ENCRYPTION_MASTER_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_CONFIRMATION=appointment_confirmation
WHATSAPP_TEMPLATE_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_BODY_PARAMS=4
WHATSAPP_TEMPLATE_REMINDER_BODY_PARAMS=3
WHATSAPP_FALLBACK_TEMPLATE=hello_world
WHATSAPP_FALLBACK_LANGUAGE=en_US
WHATSAPP_FALLBACK_BODY_PARAMS=0
# Create & approve these in Meta WhatsApp Manager (Utility category):
# appointment_confirmation: Hello {{1}}, your {{2}} appointment at {{3}} is confirmed for {{4}}. See you soon!
# appointment_reminder: Hi {{1}}, this is a reminder from {{2}} about your upcoming appointment in {{3}}. We look forward to seeing you!
# gift_card_delivery: Hello {{1}}, you received a gift card from {{2}}! Code: {{3}}. {{4}}
# {{1}} recipient name, {{2}} sender name (person), {{3}} code, {{4}} summary (includes business + redemption)
WHATSAPP_TEMPLATE_GIFT_CARD=gift_card_delivery
WHATSAPP_TEMPLATE_GIFT_CARD_BODY_PARAMS=4

# Mobile app version gates (adopt-5.5 — consumer + provider Capacitor apps)
MOBILE_CONSUMER_IOS_KILL_SWITCH=false
MOBILE_PROVIDER_ANDROID_MIN_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=booking_platform

# App
PORT=3001
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS / Frontend URL (Stripe redirect URLs)
CORS_ORIGIN=http://localhost:3000
ROOT_DOMAIN=localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative to the three vars above:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# OpenAI (AI command bar, onboarding catalog, public booking assistant, agents)
OPENAI_API_KEY=

# Stripe (platform subscriptions + Connect for client prepay at booking)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Each business connects their Stripe Connect account ID (acct_...) in Dashboard → Billing

# Email reminders (Resend — https://resend.com)
# Without this, confirmation/reminder emails are logged to the console in dev.
RESEND_API_KEY=re_...
NOTIFICATION_FROM_EMAIL=bookings@yourdomain.com

# SMS reminders (Twilio — https://twilio.com)
# Without these, SMS messages are logged to the console in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# WhatsApp Business Cloud API (Meta — https://developers.facebook.com/docs/whatsapp/cloud-api)
# Platform default — used for new tenants until they connect their own WhatsApp in Dashboard settings.
INTEGRATIONS_ENCRYPTION_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_CONFIRMATION=appointment_confirmation
WHATSAPP_TEMPLATE_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_BODY_PARAMS=4
WHATSAPP_TEMPLATE_REMINDER_BODY_PARAMS=3
WHATSAPP_FALLBACK_TEMPLATE=hello_world
WHATSAPP_FALLBACK_LANGUAGE=en_US
WHATSAPP_FALLBACK_BODY_PARAMS=0
# Create & approve these in Meta WhatsApp Manager (Utility category):
# appointment_confirmation: Hello {{1}}, your {{2}} appointment at {{3}} is confirmed for {{4}}. See you soon!
# appointment_reminder: Hi {{1}}, this is a reminder from {{2}} about your upcoming appointment in {{3}}. We look forward to seeing you!

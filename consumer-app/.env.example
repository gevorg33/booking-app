VITE_API_URL=http://127.0.0.1:3001
# Public web origin for universal links (no trailing slash)
VITE_PUBLIC_WEB_ORIGIN=http://localhost:3000
# Store listings — used on web "Download app" CTAs
VITE_IOS_APP_STORE_URL=https://apps.apple.com/app/id0000000000
VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.optischedule.consumer
# Firebase web client (same project as provider app or a dedicated consumer iOS app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set true when google-services.json / GoogleService-Info.plist are present (see scripts/prepare-env.sh)
VITE_FCM_CONFIGURED=false
# Optional crash reporter (Sentry) — release tag: provider_app@VITE_APP_VERSION
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_APP_VERSION=1.0.0

{
  "name": "optischedule-consumer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:add:ios": "cap add ios",
    "cap:android": "cap open android",
    "cap:add:android": "cap add android",
    "build:ios:lan": "bash scripts/prepare-env.sh && bash scripts/configure-ios-firebase.sh && npm run build && npx cap sync ios && xattr -cr ios 2>/dev/null || true",
    "build:android:lan": "bash scripts/prepare-apk-env.sh && bash scripts/configure-android-app-links.sh && npm run build && npx cap sync android",
    "test": "vitest run",
    "test:sprint11": "vitest run --coverage --coverage.include='src/lib/deep-link.ts' --coverage.include='src/lib/customer-auth.ts' --coverage.include='src/lib/branding.ts' --coverage.include='src/lib/recent-salons.ts' --coverage.thresholds.lines=97 --coverage.thresholds.statements=97 --coverage.thresholds.functions=100 --coverage.thresholds.branches=73"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/react": "^8.7.17",
    "@ionic/react-router": "^8.7.17",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "firebase": "^12.13.0",
    "ionicons": "^8.0.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "7.6.5",
    "@capacitor/ios": "^8.3.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}

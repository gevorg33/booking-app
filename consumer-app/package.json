{
  "name": "optischedule-consumer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:add:ios": "cap add ios",
    "cap:android": "cap open android",
    "cap:add:android": "cap add android",
    "build:ios:lan": "bash scripts/prepare-env.sh && bash scripts/configure-ios-firebase.sh && bash scripts/configure-ios-widget.sh && npm run build && npx cap sync ios && xattr -cr ios 2>/dev/null || true",
    "build:android:lan": "bash scripts/prepare-apk-env.sh && bash scripts/configure-android-app-links.sh && npm run build && npx cap sync android",
    "test": "vitest run",
    "test:sprint11": "vitest run --coverage --coverage.include='src/lib/deep-link.ts' --coverage.include='src/lib/customer-auth.ts' --coverage.include='src/lib/branding.ts' --coverage.include='src/lib/recent-salons.ts' --coverage.thresholds.lines=97 --coverage.thresholds.statements=97 --coverage.thresholds.functions=100 --coverage.thresholds.branches=73",
    "test:sprint34": "vitest run --config vitest.sprint34.config.ts --coverage",
    "test:sprint28": "vitest run --config vitest.sprint28.config.ts --coverage",
    "test:sprint32": "vitest run --config vitest.sprint32.config.ts --coverage",
    "test:sprint44": "vitest run --config vitest.sprint44.config.ts --coverage",
    "test:sprint45": "vitest run --config vitest.sprint45.config.ts --coverage",
    "test:sprint46": "vitest run --config vitest.sprint46.config.ts --coverage",
    "test:aso": "vitest run --config vitest.aso.config.ts --coverage",
    "store-listings:export": "STORE_LISTINGS_EXPORT=1 vitest run --config vitest.aso.config.ts store-listings/export-store-listings.spec.ts",
    "test:sprint36": "vitest run --config vitest.sprint36.config.ts --coverage",
    "test:sprint54": "vitest run --config vitest.sprint54.config.ts --coverage",
    "test:consumer-rewards": "vitest run src/lib/consumer-rewards-display.util.spec.ts src/components/ConsumerRewardsCard.spec.tsx",
    "test:consumer-push": "vitest run src/lib/consumer-native-push.util.spec.ts src/lib/consumer-push-foreground.util.spec.ts src/lib/deep-link.spec.ts src/components/ConsumerPushBridge.integration.spec.tsx",
    "test:consumer-widget": "vitest run src/lib/home-screen-widget.util.spec.ts src/lib/deep-link.spec.ts",
    "test:consumer-notification-prefs": "vitest run src/lib/consumer-notification-preferences.util.spec.ts",
    "test:consumer-multi-service": "vitest run src/lib/multi-service-booking.spec.ts src/lib/multi-service-checkout-payment.util.spec.ts src/lib/consumer-checkout-return.util.spec.ts src/lib/consumer-assistant-navigate.util.spec.ts src/lib/public-assistant-checkout.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-checkout-discounts": "vitest run src/lib/checkout-discounts.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-gift-cards": "vitest run src/lib/gift-card-catalog.util.spec.ts src/lib/gift-card-purchase.util.spec.ts src/lib/gift-card-redeemed.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-packages": "vitest run src/lib/package-booking.spec.ts src/lib/service-package-pricing.spec.ts src/lib/package-item-pricing.util.spec.ts src/lib/package-checkout-payment.util.spec.ts src/lib/consumer-checkout-return.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-subscriptions": "vitest run src/lib/subscription-plans.util.spec.ts src/lib/checkout-subscription.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-profile-privacy": "vitest run src/lib/consumer-growth-links.util.spec.ts src/lib/consumer-privacy-data.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-tours": "vitest run src/lib/tour-service.util.spec.ts src/lib/tour-booking.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-clinic": "vitest run src/lib/clinic-service.spec.ts src/lib/clinic-booking.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:consumer-subscriptions-account": "vitest run src/lib/subscription-account.util.spec.ts src/lib/consumer-assistant-navigate.util.spec.ts src/lib/consumer-copy.spec.ts",
    "test:sprint48": "vitest run --config vitest.sprint48.config.ts",
    "test:n99-3.1": "vitest run src/lib/deferred-install-resume.util.spec.ts src/lib/deferred-install-link.util.spec.ts src/lib/deep-link.spec.ts src/lib/activation-onboarding.util.spec.ts",
    "test:n99-3.2": "vitest run src/lib/post-booking-sign-in.util.spec.ts",
    "test:n99-3.3": "vitest run src/lib/activation-payment.util.spec.ts",
    "test:n99-3.4": "vitest run src/lib/booking-draft-resume.util.spec.ts",
    "test:n99-3.6": "vitest run src/lib/qualified-install-funnel.util.spec.ts",
    "test:n99-3.8": "vitest run src/lib/activation-path-ab.util.spec.ts src/lib/activation-path-ab-remote.util.spec.ts",
    "test:n99-4": "vitest run src/lib/push-reachability.util.spec.ts",
    "test:n99-4.1": "vitest run src/lib/ios-provisional-push.util.spec.ts",
    "test:n99-4.2": "vitest run src/lib/android-post-booking-push.util.spec.ts",
    "test:n99-4.3": "vitest run src/lib/n99-push-channel.util.spec.ts",
    "test:n99-4.4": "vitest run src/lib/value-first-push-priming.util.spec.ts",
    "test:n99-4.5": "vitest run src/lib/provisional-to-full-push.util.spec.ts",
    "test:n99-4.6": "vitest run src/lib/push-denied-reask.util.spec.ts",
    "test:n99-4.8": "vitest run src/lib/push-deliverability.util.spec.ts"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/react": "^8.7.17",
    "@ionic/react-router": "^8.7.17",
    "@sentry/capacitor": "^4.0.0",
    "@sentry/react": "^10.43.0",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "firebase": "^12.13.0",
    "ionicons": "^8.0.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "7.6.5",
    "@capacitor/ios": "^8.3.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
